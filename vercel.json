{
  "cleanUrls": false,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(img|assets)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(favicon.ico|favicon.svg|apple-touch-icon.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/projetos.html",
      "destination": "/empreendimentos.html",
      "permanent": true
    },
    {
      "source": "/servico-empreendimentos-verticais.html",
      "destination": "/empreendimentos.html",
      "permanent": true
    }
  ]
}